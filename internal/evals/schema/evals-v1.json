{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evaluation config",
  "type": "object",
  "required": ["version", "suites"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "prices": {
      "type": "object",
      "description": "Price per million tokens in USD by model, for the estimated cost of runs on your own keys.",
      "additionalProperties": {
        "type": "object",
        "required": ["input", "output"],
        "additionalProperties": false,
        "properties": { "input": { "type": "number", "minimum": 0 }, "output": { "type": "number", "minimum": 0 } }
      }
    },
    "suites": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/suite" }
    }
  },
  "$defs": {
    "assertion": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": ["contains", "icontains", "not_contains", "not_icontains", "equals", "regex", "json_path", "json_schema", "tool_sequence", "tool_count_lte", "cost_lte", "latency_lte", "choice_equals", "refusal", "no_pii", "no_secret", "no_injection_compliance"]
        },
        "value": { "type": "string" },
        "pattern": { "type": "string" },
        "path": { "type": "string" },
        "equals": {},
        "subset": {},
        "schema": { "type": ["object", "boolean"] },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "additionalProperties": false,
            "properties": { "name": { "type": "string" }, "args": { "type": "object" } }
          }
        },
        "forbidden_tools": { "type": "array", "items": { "type": "string" } },
        "canary": { "type": "string" },
        "classes": { "type": "array", "items": { "type": "string" } },
        "max": { "type": "number", "minimum": 0 }
      }
    },
    "suite": {
      "type": "object",
      "required": ["id", "target", "dataset"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "name": { "type": "string" },
        "target": {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": {
            "kind": { "enum": ["skill", "prompt", "agent_config", "mcp_server", "app", "agent_endpoint"] },
            "path": { "type": "string", "description": "The artifact under test: SKILL.md, a subagent file or a prompt file." },
            "catalog": { "type": "string", "description": "A JSON list of {name, description} the trigger cases choose among." },
            "tools": { "type": "string", "description": "A tools/list snapshot of an MCP server." },
            "url": { "type": "string" },
            "secret_env": { "type": "string", "description": "The environment variable holding the secret that signs requests to the app hook." },
            "system": { "type": "string" },
            "template": { "type": "string" },
            "slug": { "type": "string" },
            "tool_names": { "type": "array", "items": { "type": "string" } }
          }
        },
        "dataset": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": { "type": "string" },
            "columns": { "type": "object", "additionalProperties": { "type": "string" } },
            "cloud": { "type": "string" },
            "version": { "type": "integer", "minimum": 1 }
          },
          "oneOf": [{ "required": ["path"] }, { "required": ["cloud"] }]
        },
        "models": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z_]+/.+$" } },
        "repeats": { "type": "integer", "minimum": 1, "maximum": 50 },
        "seed": { "type": "integer" },
        "concurrency": { "type": "integer", "minimum": 1, "maximum": 32 },
        "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
        "max_tokens": { "type": "integer", "minimum": 1 },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 600 },
        "split": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "train": { "type": "integer", "minimum": 0, "maximum": 100 },
            "test": { "type": "integer", "minimum": 0, "maximum": 100 }
          }
        },
        "graders": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "assertions": { "type": "array", "items": { "$ref": "#/$defs/assertion" } },
            "judge": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "model": { "type": "string", "pattern": "^[a-z_]+/.+$" },
                "models": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z_]+/.+$" } },
                "rubric": { "type": "string" },
                "threshold": { "type": "number", "minimum": 0, "maximum": 1 },
                "aggregate": { "enum": ["mean", "majority", "min"] }
              }
            }
          }
        },
        "gates": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min_pass_rate": { "type": "number", "minimum": 0, "maximum": 1 },
            "no_regression_vs": { "type": "string" },
            "fail_on_inconclusive": { "type": "boolean" }
          }
        }
      }
    }
  }
}
