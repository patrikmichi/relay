{
  "servers": {
    "relay": {
      "type": "http",
      "url": "https://gateway.example.com/api/mcp",
      "headers": {
        "Authorization": "Bearer ${env:GATEWAY_API_KEY}"
      }
    },
    "docs": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@acme/docs-mcp"
      ],
      "env": {
        "DOCS_REGION": "eu"
      }
    }
  }
}
