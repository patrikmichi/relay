{
  "theme": "dark",
  "mcp": {
    "zuano": {
      "type": "remote",
      "url": "https://gateway.example.com/api/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:ZUANO_API_KEY}"
      }
    },
    "docs": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@acme/docs-mcp"
      ],
      "enabled": true,
      "environment": {
        "DOCS_REGION": "eu"
      }
    }
  }
}
